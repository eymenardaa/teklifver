PORT=3000
MONGODB_URI=mongodb://localhost:27017/teklifver
SESSION_SECRET=buraya-uzun-ve-rastgele-bir-metin-yazin

# Yasal sayfalarda ve reklam sayfasında görünür
SITE_COMPANY=Şirket Unvanınız
SITE_EMAIL=iletisim@alanadiniz.com
# Paylaşım bağlantıları ve site haritası için (canlıda)
SITE_URL=https://alanadiniz.com

# Google Search Console doğrulama kodu (isteğe bağlı)
# GOOGLE_SITE_VERIFICATION=

# Bu e-postayla kayıtlı hesap, sunucu açılışında yönetici yapılır
ADMIN_EMAIL=siz@alanadiniz.com

# Giriş kodu, şifre sıfırlama ve bildirim e-postaları için Gmail ya da SMTP.
# İkisi de boşsa geliştirmede e-postalar sunucu günlüğüne yazılır, kod istenmez.
# Gmail için hesabınızda iki adımlı doğrulamayı açıp bir uygulama şifresi oluşturun.
GMAIL_USER=
GMAIL_PASS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Sosyal giriş. Boş bırakılan sağlayıcının butonu canlıda görünmez.
# Yönlendirme adresi: SITE_URL/auth/google/callback (facebook, microsoft için de aynı biçimde)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# E-posta gönderilebiliyorsa kayıtta ve her girişte altı haneli kod istenir. Değiştirmek için true veya false yazın.
# REQUIRE_EMAIL_VERIFICATION=true

# Canlıda sunucunun önündeki vekil sunucu sayısı (varsayılan 1)
# TRUST_PROXY_HOPS=1

# Tek IP'den dakikada kabul edilen istek sayısı (varsayılan 600)
# RATE_LIMIT_PER_MINUTE=600

# Örnek veri: geliştirmede varsayılan olarak eklenir, false yazılırsa eklenmez.
# Canlıda eklenmez; showcase yazılırsa girilemeyen hesaplarla dolu bir vitrin açılır.
# DEMO_DATA=false
