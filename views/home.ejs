<%- include('partials/header') %>

<div class="wrap page">
  <%
    const lead = showcase[0];
    const gallery = showcase.slice(1, 9);
    const today = new Date().toLocaleDateString('tr-TR', { timeZone: 'Europe/Istanbul', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  %>
  <section class="front<%= lead ? '' : ' front-no-lead' %>">
    <div>
      <p class="front-date">
        <%= today %><% if (total) { %> · <%= total %> açık talep<% if (stats.todayCount) { %> · son 24 saatte <%= stats.todayCount %> yeni<% } %><% } %>
      </p>
      <h1>Yaptıracağınız işi yazın, firmalar fiyat versin.</h1>
      <p class="front-text">Tadilat, nakliye, temizlik, web sitesi. Tek tek firma aramak yerine işi bir kez anlatırsınız, gelen teklifleri yan yana görürsünüz. Talep vermek ücretsiz. Telefon numaranız, siz bir teklifi kabul edene kadar kimseye görünmez.</p>
      <div class="front-actions">
        <a class="btn btn-primary" href="/requests/new">Talep Ver</a>
        <a href="/requests">Açık talepleri incele</a>
      </div>
    </div>
    <% if (lead) { %>
      <div class="front-lead">
        <p class="front-lead-note">En çok bakılan talep</p>
        <a class="showcase-item" href="/requests/<%= lead._id %>">
          <div class="showcase-photo">
            <img src="<%= lead.images[0] %>" alt="<%= lead.title %>" decoding="async" width="600" height="400">
            <% if (isUrgent(lead)) { %><span class="label label-urgent label-on-photo">ACİL</span><% } %>
          </div>
          <div class="showcase-title"><%= lead.title %></div>
          <div class="showcase-price"><%= budgetLabel(lead.budget) %></div>
        </a>
      </div>
    <% } %>
  </section>

  <div class="front-grid">
    <div>
      <section class="box">
        <div class="box-head">Son Eklenen Talepler <a href="/requests">Tümü (<%= total %>)</a></div>
        <% if (latest.length) { %>
          <%- include('partials/listing-table', { items: latest, compact: true, adEvery: 6 }) %>
        <% } else { %>
          <div class="empty"><h2>Henüz talep yok</h2><p>İlk talebi siz verin.</p><a class="btn btn-primary" href="/requests/new">Talep Ver</a></div>
        <% } %>
      </section>

      <% if (gallery.length) { %>
        <section class="box">
          <div class="box-head">Vitrin <a href="/requests?photos=on&sort=views">Tümünü Gör</a></div>
          <%- include('partials/showcase-grid', { items: gallery, columns: 4 }) %>
        </section>
      <% } %>

      <section class="box" id="recentBox" hidden>
        <div class="box-head">Son Baktıklarınız</div>
        <div class="showcase-grid columns-4" id="recentGrid"></div>
      </section>

      <% if (closing.length) { %>
        <section class="box">
          <div class="box-head">Süresi Dolmak Üzere <a href="/requests?sort=deadline">Tümü</a></div>
          <%- include('partials/showcase-grid', { items: closing.slice(0, 4), columns: 4 }) %>
        </section>
      <% } %>

      <% if (latestReviews.length) { %>
        <section class="box">
          <div class="box-head">Müşteriler Ne Yazmış</div>
          <div class="review-grid">
            <% latestReviews.forEach(review => { %>
              <figure class="review-card">
                <div class="review-stars" role="img" aria-label="<%= review.rating %> üzerinden 5 puan">
                  <% for (let n = 1; n <= 5; n += 1) { %><%- icon('star', { size: 12, class: n <= review.rating ? 'star' : 'star-empty' }) %><% } %>
                </div>
                <blockquote><%= truncate(review.comment, 140) %></blockquote>
                <figcaption>
                  <%= shortName(review.customer.name) %>, <a href="/companies/<%= review.company._id %>"><%= review.company.companyName || review.company.name %></a> için
                </figcaption>
              </figure>
            <% }) %>
          </div>
        </section>
      <% } %>

      <section class="box">
        <div class="box-head">Nasıl İşliyor?</div>
        <p class="how-prose">İşi anlatırsınız, isterseniz fotoğraf ve bütçe eklersiniz. O alanda çalışan firmalar fiyat ve süre yazar. Fiyatlara ve yorumlara bakar, aklınıza takılanı mesajla sorarsınız. Birini seçince telefonlar karşılıklı açılır, iş bitince yorumunuzu yazarsınız. Ödeme konusunda dikkat edilecekleri <a href="/guvenli-hizmet">şurada</a> topladık.</p>
      </section>
    </div>

    <aside aria-label="Kategoriler ve öneriler">
      <section class="box">
        <div class="box-head">Kategoriler</div>
        <ul class="ledger">
          <% allCategories.forEach(category => { %>
            <li><a class="row" href="<%= categoryUrl(category.name) %>"><span><%= category.name %></span><span><%= counts[category.name] || 0 %></span></a></li>
          <% }) %>
        </ul>
      </section>

      <section class="box">
        <div class="box-head">Bugünün Rakamları</div>
        <ul class="ledger">
          <li class="row"><span>Açık talep</span><span><%= total %></span></li>
          <li class="row"><span>Son 24 saatte gelen</span><span><%= stats.todayCount %></span></li>
          <li class="row"><span>Kayıtlı firma</span><span><%= stats.companyCount %></span></li>
          <li class="row"><span>Verilen teklif</span><span><%= stats.bidCount %></span></li>
          <li class="row"><span>Tamamlanan iş</span><span><%= stats.completedCount %></span></li>
        </ul>
      </section>

      <%- include('partials/ad', { format: 'side' }) %>

      <% if (topCompanies.length) { %>
        <section class="box">
          <div class="box-head">Puanı Yüksek Firmalar <a href="/companies">Rehber</a></div>
          <ul class="ledger">
            <% topCompanies.forEach(company => { %>
              <li><a class="row" href="/companies/<%= company._id %>"><span><%= company.companyName || company.name %></span><span class="stars"><%- icon('star', { size: 11, class: 'star' }) %><%= company.rating %></span></a></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <% if (cityRows.length) { %>
        <section class="box">
          <div class="box-head">İller <a href="/iller">Tümü</a></div>
          <ul class="ledger">
            <% cityRows.slice(0, 8).forEach(row => { %>
              <li><a class="row" href="<%= cityUrl(row._id) %>"><span><%= row._id %></span><span><%= row.total %></span></a></li>
            <% }) %>
          </ul>
        </section>
      <% } %>

      <section class="box">
        <div class="box-head">Çok Arananlar</div>
        <p class="plain-links">
          <% const terms = ['mutfak', 'boya', 'banyo', 'nakliyat', 'web sitesi', 'logo', 'temizlik', 'elektrik', 'mobil uygulama', 'düğün']; %>
          <% terms.forEach((term, index) => { %><a href="/requests?search=<%= encodeURIComponent(term) %>"><%= term %></a><%= index < terms.length - 1 ? ', ' : '' %><% }) %>
        </p>
      </section>

      <%- include('partials/ad', { format: 'side' }) %>

      <section class="box">
        <div class="box-head">Firmanız mı Var?</div>
        <div class="rail-note">
          <p>Hesabınızı açın, işinize uyan taleplere fiyatınızı yazın. Üyelik ücretsiz.</p>
          <a class="btn btn-navy btn-block" href="/register?role=company">Firma Hesabı Aç</a>
        </div>
      </section>
    </aside>
  </div>
</div>

<%- include('partials/footer') %>
