<div class="field <%= errors.category ? 'has-error' : '' %>">
  <label class="field-label" for="category">Kategori</label>
  <select class="select" id="category" name="category" required>
    <option value="" disabled <%= form.category ? '' : 'selected' %>>Seçiniz</option>
    <% categories.forEach(category => { %>
      <option value="<%= category.name %>" data-tip="<%= requestTips[category.name] || '' %>" <%= form.category === category.name ? 'selected' : '' %>><%= category.name %></option>
    <% }) %>
  </select>
  <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
  <div class="tip-box" id="categoryTip" hidden>
    <span>Firmalar en çok şunları sorar. Açıklamaya başlık olarak ekleyebilirsiniz.</span>
    <button class="btn btn-sm" type="button" id="categoryTipAdd">Soruları Ekle</button>
  </div>
</div>

<div class="field <%= errors.title ? 'has-error' : '' %>">
  <label class="field-label" for="title">Talep başlığı</label>
  <input class="input" type="text" id="title" name="title" value="<%= form.title %>" maxlength="200" required>
  <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
</div>

<div class="field <%= errors.description ? 'has-error' : '' %>">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:4px">
    <label class="field-label" for="description" style="margin:0">Açıklama</label>
    <button class="btn btn-sm" type="button" id="aiEnhanceBtn" style="background:linear-gradient(135deg, #1f3b57, #0b5cad); color:#fff; border:0; gap:4px">
      <span>✨ Yapay Zekâ ile Detaylandır</span>
    </button>
  </div>
  <textarea class="textarea" id="description" name="description" rows="7" maxlength="5000" required><%= form.description %></textarea>
  <p class="field-hint">Ölçü, adres, malzeme gibi detayları yazarsanız daha doğru teklif alırsınız.</p>
  <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
</div>

<!-- Yapay Zekâ Fiyat Tahmin Kutusu -->
<div class="field">
  <div class="tip-box" id="aiPriceBox" style="background:#f0f7ff; border:1px solid #bcd3ee; display:flex; justify-content:space-between; align-items:center; padding:10px 14px">
    <div>
      <strong style="color:#0b5cad">🤖 Yapay Zekâ Fiyat Tahmini:</strong>
      <span id="aiPriceText" style="margin-left:6px; color:#222">Kategori seçildiğinde otomatik piyasa tahmini sunulur.</span>
    </div>
    <button class="btn btn-sm" type="button" id="aiApplyPrice" style="display:none">Bütçeye Uygula</button>
  </div>
</div>

<div class="field-row">
  <div class="field <%= errors.city ? 'has-error' : '' %>">
    <label class="field-label" for="city">İl <span class="optional">İsteğe bağlı</span></label>
    <select class="select" id="city" name="city">
      <option value="">Seçiniz</option>
      <% allCities.forEach(city => { %>
        <option value="<%= city %>" <%= form.city === city ? 'selected' : '' %>><%= city %></option>
      <% }) %>
    </select>
    <% if (errors.city) { %><p class="field-error"><%= errors.city %></p><% } %>
  </div>
  <div class="field">
    <label class="field-label" for="location">İlçe / Semt <span class="optional">İsteğe bağlı</span></label>
    <input class="input" type="text" id="location" name="location" maxlength="100" value="<%= form.location %>">
  </div>
</div>

<div class="field <%= errors.budget ? 'has-error' : '' %>">
  <div class="field-row">
    <div class="field">
      <label class="field-label" for="budgetMin">En az bütçe <span class="optional">İsteğe bağlı</span></label>
      <div class="input-wrap input-wrap-prefix">
        <span class="input-prefix">₺</span>
        <input class="input" type="number" id="budgetMin" name="budgetMin" min="0" step="1" inputmode="numeric" value="<%= form.budgetMin %>">
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="budgetMax">En fazla bütçe <span class="optional">İsteğe bağlı</span></label>
      <div class="input-wrap input-wrap-prefix">
        <span class="input-prefix">₺</span>
        <input class="input" type="number" id="budgetMax" name="budgetMax" min="0" step="1" inputmode="numeric" value="<%= form.budgetMax %>">
      </div>
    </div>
  </div>
  <% if (errors.budget) { %><p class="field-error"><%= errors.budget %></p><% } %>
</div>

<div class="field-row">
  <div class="field <%= errors.deadline ? 'has-error' : '' %>" style="max-width:220px">
    <label class="field-label" for="deadline">Son tarih <span class="optional">İsteğe bağlı</span></label>
    <input class="input" type="date" id="deadline" name="deadline" min="<%= dateInput() %>" value="<%= form.deadline %>">
    <% if (errors.deadline) { %><p class="field-error"><%= errors.deadline %></p><% } %>
  </div>
</div>

<!-- Para Kazandıran Özellikler: İlanı Öne Çıkarma & Acil İlan -->
<div class="field" style="margin-top:10px; padding:12px; background:var(--head); border:1px solid var(--line); border-radius:4px">
  <span class="field-label" style="font-weight:bold; margin-bottom:8px; display:block">🚀 İlanınızı Öne Çıkarın (Daha Hızlı Teklif Alın)</span>
  <div style="display:flex; flex-direction:column; gap:8px">
    <label style="display:flex; align-items:center; gap:8px; cursor:pointer">
      <input type="checkbox" name="isFeatured" <%= form.isFeatured ? 'checked' : '' %>>
      <span><strong>Vitrin İlanı:</strong> Talebiniz ana sayfa vitrininde ve aramalarda en üstte yer alsın.</span>
    </label>
    <label style="display:flex; align-items:center; gap:8px; cursor:pointer">
      <input type="checkbox" name="isUrgent" <%= form.isUrgent ? 'checked' : '' %>>
      <span><strong style="color:var(--price)">Acil Talep:</strong> İlanınıza kırmızı "ACİL" rozeti eklenir, firmalar öncelik verir.</span>
    </label>
  </div>
</div>

<% if (locals.existingImages && existingImages.length) { %>
  <div class="field">
    <span class="field-label">Mevcut fotoğraflar</span>
    <div class="thumbs">
      <% existingImages.forEach(image => { %>
        <label class="upload-thumb" title="Kaldırmak için tıklayın">
          <input type="checkbox" name="removeImages" value="<%= image %>" aria-label="Bu fotoğrafı kaldır">
          <img src="<%= image %>" alt="">
          <span class="thumb-remove">×</span>
        </label>
      <% }) %>
    </div>
    <p class="field-hint">Kaldırmak istediklerinizi işaretleyin, kaydedince silinir.</p>
  </div>
<% } %>

<div class="field <%= errors.images ? 'has-error' : '' %>">
  <span class="field-label">Fotoğraf <span class="optional">İsteğe bağlı</span></span>
  <label class="dropzone">
    <input class="visually-hidden" type="file" id="images" name="images" multiple accept="image/jpeg,image/png,image/gif,image/webp" data-max="<%= maxImages %>">
    <span class="dropzone-title">Fotoğraf Seç</span>
    <span class="muted small">veya buraya sürükleyin. En fazla <%= maxImages %> fotoğraf, her biri en çok 5 MB.</span>
  </label>
  <div class="thumbs" id="imagePreviews"></div>
  <p class="field-error" id="imagesError" <%= errors.images ? '' : 'hidden' %>><%= errors.images || '' %></p>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
  const catSelect = document.getElementById('category');
  const descEl = document.getElementById('description');
  const aiPriceBox = document.getElementById('aiPriceBox');
  const aiPriceText = document.getElementById('aiPriceText');
  const aiApplyBtn = document.getElementById('aiApplyPrice');
  const minInput = document.getElementById('budgetMin');
  const maxInput = document.getElementById('budgetMax');
  const aiEnhanceBtn = document.getElementById('aiEnhanceBtn');

  let currentEstimate = null;

  async function updateAiEstimate() {
    const category = catSelect.value;
    if (!category) return;
    try {
      const res = await fetch('/ai/price-estimate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category, description: descEl.value })
      });
      const data = await res.json();
      currentEstimate = data;
      aiPriceText.innerHTML = `<strong>${data.min.toLocaleString('tr-TR')} ₺ - ${data.max.toLocaleString('tr-TR')} ₺</strong> (${data.unit})`;
      aiApplyBtn.style.display = 'inline-block';
    } catch (e) {}
  }

  catSelect.addEventListener('change', updateAiEstimate);

  if (aiApplyBtn) {
    aiApplyBtn.addEventListener('click', () => {
      if (currentEstimate) {
        minInput.value = currentEstimate.min;
        maxInput.value = currentEstimate.max;
      }
    });
  }

  if (aiEnhanceBtn) {
    aiEnhanceBtn.addEventListener('click', async () => {
      const category = catSelect.value;
      if (!category) {
        alert('Lütfen önce bir kategori seçin.');
        return;
      }
      aiEnhanceBtn.disabled = true;
      aiEnhanceBtn.innerText = 'Yapay Zekâ Yazıyor...';
      try {
        const res = await fetch('/ai/enhance-description', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ category, text: descEl.value })
        });
        const data = await res.json();
        if (data.enhanced) {
          descEl.value = (descEl.value ? descEl.value + '\n\n' : '') + data.enhanced;
          updateAiEstimate();
        }
      } catch (e) {
      } finally {
        aiEnhanceBtn.disabled = false;
        aiEnhanceBtn.innerText = '✨ Yapay Zekâ ile Detaylandır';
      }
    });
  }
});
</script>
