<div class="field <%= errors.category ? 'has-error' : '' %>">
  <label class="field-label" for="category">Kategori</label>
  <select class="select" id="category" name="category" required>
    <option value="" disabled <%= form.category ? '' : 'selected' %>>Seçiniz</option>
    <% categories.forEach(category => { %>
      <option value="<%= category.name %>" data-tip="<%= requestTips[category.name] || '' %>" <%= form.category === category.name ? 'selected' : '' %>><%= category.name %></option>
    <% }) %>
  </select>
  <% if (errors.category) { %><p class="field-error"><%= errors.category %></p><% } %>
  <div class="tip-box" id="categoryTip" hidden>
    <span>Firmalar en çok şunları sorar. Açıklamaya başlık olarak ekleyebilirsiniz.</span>
    <button class="btn btn-sm" type="button" id="categoryTipAdd">Soruları Ekle</button>
  </div>
</div>

<div class="field <%= errors.title ? 'has-error' : '' %>">
  <label class="field-label" for="title">Talep başlığı</label>
  <input class="input" type="text" id="title" name="title" value="<%= form.title %>" maxlength="200" placeholder="Örneğin: Mutfak dolabı kapakları değişecek" required>
  <% if (errors.title) { %><p class="field-error"><%= errors.title %></p><% } %>
</div>

<div class="field <%= errors.description ? 'has-error' : '' %>">
  <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px">
    <label class="field-label" for="description" style="margin:0">Açıklama</label>
    <button class="btn btn-sm" type="button" id="aiEnhanceBtn" style="background:var(--navy); color:#fff; border:0; gap:4px">
      <span>✨ Yapay Zekâ ile Detaylandır</span>
    </button>
  </div>
  <textarea class="textarea" id="description" name="description" rows="7" maxlength="5000" placeholder="Ölçü, kat, malzeme, ne zaman başlanacağı gibi firmaların soracağı şeyleri yazın." required><%= form.description %></textarea>
  <p class="field-hint">Ölçü, adres, malzeme gibi detayları yazarsanız daha doğru teklif alırsınız. Telefon numaranızı buraya yazmayın.</p>
  <% if (errors.description) { %><p class="field-error"><%= errors.description %></p><% } %>
</div>

<!-- Yapay Zekâ Fiyat Tahmin Kutusu -->
<div class="field">
  <div class="tip-box" id="aiPriceBox" style="background:var(--head); border:1px solid var(--line); display:flex; justify-content:space-between; align-items:center; padding:10px 14px; border-radius:var(--radius)">
    <div>
      <strong style="color:var(--link)">🤖 Yapay Zekâ Fiyat Tahmini:</strong>
      <span id="aiPriceText" style="margin-left:6px; color:var(--text)">Kategori seçildiğinde otomatik piyasa tahmini sunulur.</span>
    </div>
    <button class="btn btn-sm" type="button" id="aiApplyPrice" style="display:none">Bütçeye Uygula</button>
  </div>
</div>

<fieldset class="form-optional">
<legend>İsterseniz ekleyin</legend>
<div class="field-row">
  <div class="field <%= errors.city ? 'has-error' : '' %>">
    <label class="field-label" for="city">İl</label>
    <select class="select" id="city" name="city">
      <option value="">Seçiniz</option>
      <% allCities.forEach(city => { %>
        <option value="<%= city %>" <%= form.city === city ? 'selected' : '' %>><%= city %></option>
      <% }) %>
    </select>
    <% if (errors.city) { %><p class="field-error"><%= errors.city %></p><% } %>
  </div>
  <div class="field">
    <label class="field-label" for="location">İlçe / semt</label>
    <input class="input" type="text" id="location" name="location" maxlength="100" value="<%= form.location %>">
  </div>
</div>

<div class="field <%= errors.budget ? 'has-error' : '' %>">
  <div class="field-row">
    <div class="field">
      <label class="field-label" for="budgetMin">En az bütçe</label>
      <div class="input-wrap input-wrap-suffix">
        <span class="input-suffix">TL</span>
        <input class="input" type="number" id="budgetMin" name="budgetMin" min="0" step="1" inputmode="numeric" value="<%= form.budgetMin %>">
      </div>
    </div>
    <div class="field">
      <label class="field-label" for="budgetMax">En fazla bütçe</label>
      <div class="input-wrap input-wrap-suffix">
        <span class="input-suffix">TL</span>
        <input class="input" type="number" id="budgetMax" name="budgetMax" min="0" step="1" inputmode="numeric" value="<%= form.budgetMax %>">
      </div>
    </div>
  </div>
  <% if (errors.budget) { %><p class="field-error"><%= errors.budget %></p><% } %>
</div>

<div class="field-row">
  <div class="field <%= errors.deadline ? 'has-error' : '' %>" style="max-width:220px">
    <label class="field-label" for="deadline">Son tarih <span class="optional">İsteğe bağlı</span></label>
    <input class="input" type="date" id="deadline" name="deadline" min="<%= dateInput() %>" value="<%= form.deadline %>">
    <% if (errors.deadline) { %><p class="field-error"><%= errors.deadline %></p><% } %>
  </div>
  <div class="field">
    <label class="field-label" for="discoveryTime">Keşif / Randevu Uygunluğu <span class="optional">İsteğe bağlı</span></label>
    <select class="select" id="discoveryTime" name="discoveryTime">
      <option value="">Keşif gerekmiyor / Fark etmez</option>
      <option value="Hafta içi gündüz (09:00 - 17:00)" <%= form.discoveryTime === 'Hafta içi gündüz (09:00 - 17:00)' ? 'selected' : '' %>>Hafta içi gündüz (09:00 - 17:00)</option>
      <option value="Hafta içi akşam (18:00 - 21:00)" <%= form.discoveryTime === 'Hafta içi akşam (18:00 - 21:00)' ? 'selected' : '' %>>Hafta içi akşam (18:00 - 21:00)</option>
      <option value="Hafta sonu herhangi bir saat" <%= form.discoveryTime === 'Hafta sonu herhangi bir saat' ? 'selected' : '' %>>Hafta sonu herhangi bir saat</option>
    </select>
  </div>
</div>

<!-- Para Kazandıran Özellikler: İlanı Öne Çıkarma & Acil İlan -->
<div class="field" style="margin-top:10px; padding:12px; background:var(--head); border:1px solid var(--line); border-radius:var(--radius)">
  <span class="field-label" style="font-weight:bold; margin-bottom:8px; display:block">🚀 İlanınızı Öne Çıkarın (Daha Hızlı Teklif Alın)</span>
  <div style="display:flex; flex-direction:column; gap:8px">
    <label style="display:flex; align-items:center; gap:8px; cursor:pointer">
      <input type="checkbox" name="isFeatured" <%= form.isFeatured ? 'checked' : '' %>>
      <span><strong>Vitrin İlanı:</strong> Talebiniz ana sayfa vitrininde ve aramalarda en üstte yer alsın.</span>
    </label>
    <label style="display:flex; align-items:center; gap:8px; cursor:pointer">
      <input type="checkbox" name="isUrgent" <%= form.isUrgent ? 'checked' : '' %>>
      <span><strong style="color:var(--urgent)">Acil Talep:</strong> İlanınıza kırmızı "ACİL" rozeti eklenir, firmalar öncelik verir.</span>
    </label>
  </div>
</div>
</fieldset>

<% if (locals.existingImages && existingImages.length) { %>
  <div class="field">
    <span class="field-label">Mevcut fotoğraflar</span>
    <div class="thumbs">
      <% existingImages.forEach(image => { %>
        <label class="upload-thumb" title="Kaldırmak için tıklayın">
          <input type="checkbox" name="removeImages" value="<%= image %>" aria-label="Bu fotoğrafı kaldır">
          <img src="<%= image %>" alt="">
          <span class="thumb-remove">×</span>
        </label>
      <% }) %>
    </div>
    <p class="field-hint">Kaldırmak istediklerinizi işaretleyin, kaydedince silinir.</p>
  </div>
<% } %>

<div class="field <%= errors.images ? 'has-error' : '' %>">
  <span class="field-label">Fotoğraf</span>
  <label class="dropzone">
    <input class="visually-hidden" type="file" id="images" name="images" multiple accept="image/jpeg,image/png,image/gif,image/webp" data-max="<%= maxImages %>">
    <span class="dropzone-title">Fotoğraf seçin</span>
    <span class="muted small">ya da buraya sürükleyin. En fazla <%= maxImages %> fotoğraf, her biri 5 MB olabilir.</span>
  </label>
  <div class="thumbs" id="imagePreviews"></div>
  <p class="field-error" id="imagesError" <%= errors.images ? '' : 'hidden' %>><%= errors.images || '' %></p>
</div>
