<%- include('../partials/header') %>

<div class="wrap page">
  <div class="layout">
    <aside><%- include('../partials/panel-menu') %></aside>

    <section class="box">
      <div class="box-head">İstatistikler</div>
      <div class="summary">
        <div><strong><%= totals.sent %></strong><span>Gönderilen teklif</span></div>
        <div><strong><%= totals.won %></strong><span>Kazanılan iş</span></div>
        <div><strong><%= totals.winRate === null ? '-' : '%' + totals.winRate %></strong><span>Kazanma oranı</span></div>
        <div><strong><%= profileViews %></strong><span>Firma sayfası görüntülenme</span></div>
      </div>

      <% if (!totals.sent) { %>
        <div class="empty">
          <h2>Henüz teklif vermediniz</h2>
          <p>İlk tekliflerinizden sonra burada ay ay kaç teklif verdiğinizi ve kaçını kazandığınızı göreceksiniz.</p>
          <a class="btn btn-primary" href="/dashboard/matches">Size Uygun Talepler</a>
        </div>
      <% } else { %>
        <div class="box-body">
          <h2 class="section-title">Son altı ay</h2>
          <table class="month-table">
            <thead><tr><th>Ay</th><th>Teklif</th><th><span class="visually-hidden">Grafik</span></th><th>Kazanılan</th></tr></thead>
            <tbody>
              <% months.forEach(month => { %>
                <tr>
                  <td><%= month.label %></td>
                  <td class="num"><%= month.sent %></td>
                  <td class="month-bar-cell" aria-hidden="true">
                    <span class="month-bar" style="width:<%= Math.round((month.sent / busiestMonth) * 100) %>%"><span class="month-bar-won" style="width:<%= month.sent ? Math.round((month.won / month.sent) * 100) : 0 %>%"></span></span>
                  </td>
                  <td class="num"><%= month.won %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
          <p class="small muted month-legend"><span class="legend-won"></span> Kazanılan &nbsp; <span class="legend-sent"></span> Toplam teklif</p>

          <table class="info-table">
            <tr><td>Kazanılan işlerin toplamı</td><td><strong><%= money(totals.wonAmount) %></strong></td></tr>
            <tr><td>Ortalama teklif tutarı</td><td><%= money(totals.averageAmount) %></td></tr>
            <tr><td>Ortalama teslim süresi</td><td><%= totals.averageDays %> gün</td></tr>
            <tr><td>Bekleyen / reddedilen</td><td><%= totals.waiting %> / <%= totals.lost %></td></tr>
            <tr><td>Müşteri puanı</td><td><%= company.ratingCount ? `${ratingLabel(company.rating)} (${company.ratingCount} değerlendirme)` : 'Henüz değerlendirme yok' %></td></tr>
          </table>
          <p class="box-note">Kazanma oranı sonucu belli olan tekliflerden hesaplanır; bekleyen teklifler dahil değildir.</p>
        </div>
      <% } %>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
