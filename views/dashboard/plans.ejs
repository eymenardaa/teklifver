<%- include('../partials/header') %>

<div class="wrap page">
  <div class="layout">
    <aside><%- include('../partials/panel-menu') %></aside>

    <section class="box">
      <div class="box-head">Paketler</div>
      <div class="box-body">
        <p class="plan-status">
          Paketiniz: <strong><%= allowance.plan.name %></strong>.
          <% if (allowance.limited) { %>
            Bu ay <strong><%= allowance.used %></strong> teklif verdiniz, <strong><%= allowance.left %></strong> hakkınız kaldı. Hak her ayın ilk günü yenilenir.
          <% } else { %>
            Teklif sınırınız yok.
          <% } %>
        </p>
        <% if (allowance.limited) { %>
          <progress class="meter" max="<%= allowance.plan.monthlyBids %>" value="<%= allowance.used %>" aria-label="Bu ay kullanılan teklif hakkı"></progress>
        <% } %>

        <div class="plan-grid">
          <% plans.forEach(plan => { const current = plan.key === allowance.plan.key; %>
            <div class="plan-card <%= current ? 'is-current' : '' %>">
              <h2 class="plan-name"><%= plan.name %></h2>
              <div class="plan-price"><%= plan.price ? money(plan.price) : 'Ücretsiz' %><% if (plan.price) { %> <span>/ ay</span><% } %></div>
              <ul class="plan-list">
                <li><strong><%= plan.monthlyBids === null ? 'Sınırsız teklif' : `Ayda ${plan.monthlyBids} teklif` %></strong></li>
                <li>Firma sayfası, portföy ve yorumlar</li>
                <li>Müşterilerle mesajlaşma</li>
              </ul>
              <% if (current) { %>
                <p class="plan-current">Şu anki paketiniz</p>
              <% } else if (plan.price) { %>
                <a class="btn btn-block <%= plan.key === 'pro' ? 'btn-primary' : '' %>" href="/iletisim?paket=<%= plan.key %>">Bu pakete geçmek istiyorum</a>
              <% } %>
            </div>
          <% }) %>
        </div>
        <p class="box-note">Sitede şimdilik kartla ödeme alınmıyor. Paket isteğinizi iletişim formundan gönderin; ödeme ve fatura için size e-postayla dönülür, paketiniz onaydan sonra açılır.</p>
      </div>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
