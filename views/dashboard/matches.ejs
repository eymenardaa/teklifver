<%- include('../partials/header') %>

<div class="wrap page">
  <div class="layout">
    <aside><%- include('../partials/panel-menu') %></aside>

    <section class="box">
      <div class="box-head">Size Uygun Talepler (<%= requests.length %>) <a href="/profile">Kategori ve İlleri Düzenle</a></div>
      <% if (serviceCities.length) { %>
        <p class="box-note">
          <% if (showAll) { %>
            Tüm illerdeki talepler gösteriliyor. <a href="/dashboard/matches">Yalnızca <%= serviceCities.join(', ') %></a>
          <% } else { %>
            <%= serviceCities.join(', ') %> için gösteriliyor. <a href="/dashboard/matches?all=1">Tüm illeri göster</a>
          <% } %>
        </p>
      <% } %>
      <% if (!hasCategories) { %>
        <div class="empty">
          <h2>Henüz kategori seçmediniz</h2>
          <p>Hizmet verdiğiniz kategorileri seçin; size uygun talepleri burada görün ve bildirim alın.</p>
          <a class="btn btn-primary" href="/profile">Kategori Seç</a>
        </div>
      <% } else if (requests.length === 0) { %>
        <div class="empty">
          <h2>Şu an size uygun yeni talep yok</h2>
          <a class="btn" href="/requests">Tüm Talepler</a>
        </div>
      <% } else { %>
        <%- include('../partials/listing-table', { items: requests }) %>
      <% } %>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
