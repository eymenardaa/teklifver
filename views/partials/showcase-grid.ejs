<div class="showcase-grid <%= locals.columns ? 'columns-' + columns : '' %>">
  <% items.forEach(item => { %>
    <a class="showcase-item" href="/requests/<%= item._id %>">
      <div class="showcase-photo">
        <% if (item.images && item.images.length) { %>
          <img src="<%= thumb(item.images[0]) %>" alt="<%= item.title %>" loading="lazy" width="240" height="180">
        <% } else { %>
          <span class="no-photo"><%- icon('camera-off', { size: 22 }) %>Fotoğraf yok</span>
        <% } %>
        <% if (isUrgent(item)) { %><span class="label label-urgent label-on-photo">ACİL</span><% } %>
      </div>
      <div class="showcase-title"><%= item.title %></div>
      <div class="showcase-price"><%= budgetLabel(item.budget) %></div>
    </a>
  <% }) %>
</div>
