<% const ad = nextAd(); if (ad) { const external = /^https?:/.test(ad.url); %>
  <a class="ad ad-<%= format %> ad-<%= ad.color || 'navy' %>" href="<%= ad._id ? '/reklam-tik/' + ad._id : ad.url %>" <%- external ? 'target="_blank" rel="sponsored noopener"' : '' %>>
    <span class="ad-label">Reklam</span>
    <% if (ad.banner) { %>
      <img class="ad-banner" src="<%= ad.banner %>" alt="<%= ad.title %>" loading="lazy">
    <% } else { %>
      <% if (ad.image) { %><img class="ad-image" src="<%= thumb(ad.image) %>" alt="" loading="lazy" decoding="async"><% } %>
      <span class="ad-copy">
        <strong class="ad-title"><%= ad.title %></strong>
        <span class="ad-text"><%= ad.text %></span>
      </span>
      <span class="ad-cta"><%= ad.cta %></span>
    <% } %>
  </a>
<% } %>
