<div class="field <%= locals.fieldError ? 'has-error' : '' %>">
  <label class="field-label" for="<%= fieldId %>"><%= fieldLabel %></label>
  <div class="input-wrap">
    <input class="input input-has-toggle" type="password" id="<%= fieldId %>" name="<%= fieldId %>"
      autocomplete="<%= autocomplete %>" required
      <%- locals.minLength ? `minlength="${minLength}"` : '' %>
      <%= locals.fieldError ? 'aria-invalid=true' : '' %>>
    <button class="password-toggle" type="button" aria-label="Şifreyi göster" aria-pressed="false">
      <%- icon('eye', { size: 15, class: 'icon-show' }) %>
      <%- icon('eye-off', { size: 15, class: 'icon-hide' }) %>
    </button>
  </div>
  <% if (locals.fieldError) { %>
    <p class="field-error"><%= fieldError %></p>
  <% } else if (locals.minLength) { %>
    <p class="field-hint" data-password-hint="<%= fieldId %>">En az <%= minLength %> karakter</p>
  <% } %>
</div>
