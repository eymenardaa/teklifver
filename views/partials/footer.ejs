  </main>

  <footer class="site-footer">
    <div class="wrap">
      <div class="footer-grid">
        <div>
          <h2>Talepler</h2>
          <ul>
            <li><a href="/requests">Tüm Talepler</a></li>
            <li><a href="/requests?period=1">Son 24 Saat</a></li>
            <li><a href="/requests?noBids=on">Teklif Almamış Talepler</a></li>
            <li><a href="/requests/new">Ücretsiz Talep Ver</a></li>
            <li><a href="/iller">İllere Göre Talepler</a></li>
            <li><a href="/fiyat-rehberi">Fiyat Rehberi</a></li>
          </ul>
        </div>
        <div>
          <h2>Kategoriler</h2>
          <ul>
            <% allCategories.slice(0, 4).forEach(category => { %>
              <li><a href="/requests?category=<%= encodeURIComponent(category.name) %>"><%= category.name %></a></li>
            <% }) %>
            <li><a href="/kategoriler">Tüm Kategoriler</a></li>
          </ul>
        </div>
        <div>
          <h2>Firmalar</h2>
          <ul>
            <li><a href="/companies">Firma Rehberi</a></li>
            <li><a href="/register?role=company">Firma Hesabı Aç</a></li>
            <li><a href="/firmalar-icin">Firmalar İçin</a></li>
            <li><a href="/guvenli-hizmet">Güvenli Hizmet Rehberi</a></li>
          </ul>
        </div>
        <div>
          <h2>Kurumsal</h2>
          <ul>
            <li><a href="/hakkimizda">Hakkımızda</a></li>
            <li><a href="/yardim">Yardım</a></li>
            <li><a href="/iletisim">İletişim</a></li>
            <li><a href="/reklam">Reklam Ver</a></li>
            <li><a href="/kullanim-kosullari">Kullanım Koşulları</a></li>
            <li><a href="/gizlilik">Gizlilik ve KVKK</a></li>
            <li><a href="/cerez-politikasi">Çerez Politikası</a></li>
            <li><a href="/veri-silme">Hesap ve Veri Silme</a></li>
            <li><button class="footer-link" type="button" data-cookie-open>Çerez Tercihleri</button></li>
          </ul>
        </div>
        <div>
          <h2>Hesabım</h2>
          <ul>
            <% if (currentUser) { %>
              <li><a href="/dashboard"><%= currentUser.role === 'company' ? 'Tekliflerim' : 'Taleplerim' %></a></li>
              <li><a href="/dashboard/favorites">Favorilerim</a></li>
              <li><a href="/profile">Hesap Bilgilerim</a></li>
            <% } else { %>
              <li><a href="/login">Giriş Yap</a></li>
              <li><a href="/register">Hesap Aç</a></li>
            <% } %>
          </ul>
        </div>
      </div>
      <div class="footer-bottom">
        <span>© <%= new Date().getFullYear() %> TeklifVer</span>
        <% if (demoActive) { %><span>Sitedeki talep, firma, reklam ve puanlar örnek veridir.</span><% } %>
      </div>
    </div>
  </footer>

  <nav class="bottom-nav" aria-label="Ana menü">
    <a href="/" class="<%= currentPath === '/' ? 'is-active' : '' %>"><%- icon('house', { size: 18 }) %><span>Ana Sayfa</span></a>
    <a href="/requests" class="<%= currentPath === '/requests' ? 'is-active' : '' %>"><%- icon('search', { size: 18 }) %><span>Talepler</span></a>
    <% if (currentUser && currentUser.role === 'company') { %>
      <a href="/dashboard/matches" class="<%= currentPath === '/dashboard/matches' ? 'is-active' : '' %>"><%- icon('briefcase', { size: 18 }) %><span>Uygun İşler</span></a>
    <% } else { %>
      <a href="/requests/new" class="<%= currentPath === '/requests/new' ? 'is-active' : '' %>"><%- icon('circle-plus', { size: 18 }) %><span>Talep Ver</span></a>
    <% } %>
    <% if (currentUser) { %>
      <a href="/messages" class="<%= currentPath.startsWith('/messages') ? 'is-active' : '' %>"><%- icon('message-square', { size: 18 }) %><span>Mesajlar</span><span class="unread-count" data-count="messages" <%= unreadMessages ? '' : 'hidden' %>><%= unreadMessages %></span></a>
      <a href="/dashboard" class="<%= currentPath === '/dashboard' ? 'is-active' : '' %>"><%- icon('user', { size: 18 }) %><span>Hesabım</span></a>
    <% } else { %>
      <a href="/companies" class="<%= currentPath === '/companies' ? 'is-active' : '' %>"><%- icon('building-2', { size: 18 }) %><span>Firmalar</span></a>
      <a href="/login" class="<%= currentPath === '/login' ? 'is-active' : '' %>"><%- icon('user', { size: 18 }) %><span>Giriş</span></a>
    <% } %>
  </nav>

  <aside aria-label="Sayfa araçları">
    <button class="to-top" id="toTop" type="button" aria-label="Sayfa başına dön" hidden><%- icon('chevron-up', { size: 18 }) %></button>
  </aside>

  <section class="cookie-banner" id="cookieBanner" role="dialog" aria-label="Çerez tercihleri" hidden>
    <div class="wrap cookie-inner">
      <div class="cookie-text">
        <strong>Çerez Kullanımı</strong>
        <p>Sitenin çalışması için zorunlu çerezler kullanıyoruz. Size özel kolaylıklar, ölçümleme ve reklam için onayınızı istiyoruz. Ayrıntılar için <a href="/cerez-politikasi">Çerez Politikası</a>.</p>

        <form class="cookie-options" id="cookieOptions" hidden>
          <label class="check-line"><input type="checkbox" checked disabled> <span><strong>Zorunlu</strong> · Oturum ve güvenlik için gereklidir, kapatılamaz.</span></label>
          <label class="check-line"><input type="checkbox" name="preferences"> <span><strong>Tercih</strong> · Son gezdiğiniz talepleri hatırlar.</span></label>
          <label class="check-line"><input type="checkbox" name="analytics"> <span><strong>Analitik</strong> · Sitenin nasıl kullanıldığını ölçmek için.</span></label>
          <label class="check-line"><input type="checkbox" name="ads"> <span><strong>Reklam</strong> · İlgi alanlarınıza göre reklam göstermek için.</span></label>
        </form>
      </div>
      <div class="cookie-actions">
        <button class="btn btn-primary" type="button" data-cookie="all">Tümünü Kabul Et</button>
        <button class="btn" type="button" data-cookie="none">Reddet</button>
        <button class="btn" type="button" id="cookieSettings">Tercihler</button>
        <button class="btn btn-navy" type="button" id="cookieSave" hidden>Seçimi Kaydet</button>
      </div>
    </div>
  </section>

  <dialog class="dialog" id="confirmDialog" aria-labelledby="confirmMessage">
    <p id="confirmMessage"></p>
    <div class="dialog-actions">
      <button class="btn btn-sm" type="button" id="confirmCancel">Vazgeç</button>
      <button class="btn btn-primary btn-sm" type="button" id="confirmAccept">Onayla</button>
    </div>
  </dialog>
</body>
</html>
