<% const adEvery = locals.adEvery || 0; %>
<table class="listing-table is-feed">
  <thead class="visually-hidden">
    <tr>
      <th>Fotoğraf</th>
      <th>Talep</th>
      <th>Bütçe ve teklif sayısı</th>
      <th>Favori</th>
    </tr>
  </thead>
  <tbody>
    <% items.forEach((item, index) => { const budget = budgetLabel(item.budget); %>
      <% if (adEvery && index > 0 && index % adEvery === 0) { %>
        <tr class="ad-row"><td colspan="4"><%- include('ad', { format: 'inline' }) %></td></tr>
      <% } %>
      <tr>
        <td class="col-photo">
          <a class="thumb" href="/requests/<%= item._id %>" tabindex="-1" aria-hidden="true">
            <% const photo = requestImage(item); %>
            <img src="<%= thumb(photo) %>" alt="<%= item.title %>" loading="lazy" decoding="async" width="240" height="180">
            <% if (item.isAuction) { %><span class="badge-auction" title="Canlı Eksiltme / Açık Artırma"><%- icon('zap', { size: 10 }) %> Eksiltme</span><% } %>
            <% if (item.video) { %><span class="video-badge" title="Videolu talep"><%- icon('video', { size: 11 }) %></span><% } %>
            <% const cb = countdownBadge(item); if (cb && cb.tone !== 'normal') { %><span class="countdown-badge countdown-<%= cb.tone %>"><%- icon('clock', { size: 9 }) %> <%= cb.text %></span><% } %>
            <% if (item.images && item.images.length > 1) { %><span class="photo-count"><%- icon('camera', { size: 10 }) %><%= item.images.length %></span><% } %>
          </a>
        </td>
        <td>
          <a class="listing-title" href="/requests/<%= item._id %>"><%= truncate(item.title, 90) %></a>
          <% if (isUrgent(item)) { %><span class="label label-urgent">ACİL</span><% } %>
          <% if (isFresh(item)) { %><span class="label label-new">YENİ</span><% } %>
          <% if (item.description) { %><p class="listing-snippet"><%= truncate(item.description.replace(/\s+/g, ' '), 170) %></p><% } %>
          <div class="listing-meta">
            <span class="listing-place"><%= placeLabel(item) %></span>
            <span title="<%= formatDate(item.createdAt) %>"><%= timeAgo(item.createdAt) %></span>
            <span><%= item.category %></span>
          </div>
        </td>
        <td class="col-budget">
          <% if (budget === 'Belirtilmemiş') { %>
            <span class="price-tag is-open">Bütçe belirtilmemiş</span>
          <% } else { %>
            <span class="price-tag"><%= budget %></span>
          <% } %>
          <span class="listing-bids"><b><%= item.bidCount %></b> teklif</span>
        </td>
        <td class="col-fav"><%- include('favorite', { item }) %></td>
      </tr>
    <% }) %>
  </tbody>
</table>
