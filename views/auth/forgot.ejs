<%- include('../partials/header') %>

<div class="wrap">
  <div class="auth-box">
    <div class="box">
      <div class="box-head">Şifremi Unuttum</div>
      <div class="box-body">
        <form class="form" action="/forgot" method="POST">
          <% if (errors.form) { %><div class="form-error" role="alert"><%= errors.form %></div><% } %>
          <p class="muted">E-posta adresinizi yazın, size şifre sıfırlama bağlantısı gönderelim. Bağlantı 1 saat geçerlidir.</p>
          <div class="field">
            <label class="field-label" for="email">E-posta adresi</label>
            <input class="input" type="email" id="email" name="email" autocomplete="email" required>
          </div>
          <button class="btn btn-primary btn-block" type="submit">Bağlantı Gönder</button>
        </form>
      </div>
      <div class="auth-foot"><a href="/login"><strong>Giriş sayfasına dön</strong></a></div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
