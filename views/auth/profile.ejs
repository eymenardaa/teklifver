<%- include('../partials/header') %>

<div class="wrap page">
  <div class="layout">
    <aside><%- include('../partials/panel-menu') %></aside>

    <div>
      <section class="box">
        <div class="box-head">
          Hesap Bilgilerim
          <span class="small" style="font-weight:normal"><%= profile.role === 'company' ? 'Firma hesabı' : 'Bireysel hesap' %><% if (profile.role === 'company' && profile.ratingCount > 0) { %> · Puan: <%= ratingLabel(profile.rating) %> (<%= profile.ratingCount %>)<% } %></span>
        </div>
        <div class="box-body" style="max-width:600px">
          <form class="form" action="/profile" method="POST">
            <div class="field <%= errors.name ? 'has-error' : '' %>">
              <label class="field-label" for="name">Ad soyad</label>
              <input class="input" type="text" id="name" name="name" value="<%= profile.name %>" autocomplete="name" required>
              <% if (errors.name) { %><p class="field-error"><%= errors.name %></p><% } %>
            </div>
            <div class="field">
              <label class="field-label" for="emailReadonly">E-posta adresi</label>
              <input class="input" type="email" id="emailReadonly" value="<%= profile.email %>" disabled>
            </div>
            <div class="field <%= errors.phone ? 'has-error' : '' %>">
              <label class="field-label" for="phone">Telefon <span class="optional">İsteğe bağlı</span></label>
              <input class="input" type="tel" id="phone" name="phone" maxlength="25" value="<%= profile.phone || '' %>" autocomplete="tel">
              <p class="field-hint">Yalnızca kabul edilen tekliflerde karşı tarafa gösterilir.</p>
              <% if (errors.phone) { %><p class="field-error"><%= errors.phone %></p><% } %>
            </div>
            <% if (profile.role === 'company') { %>
              <div class="field <%= errors.companyName ? 'has-error' : '' %>">
                <label class="field-label" for="companyName">Firma adı</label>
                <input class="input" type="text" id="companyName" name="companyName" value="<%= profile.companyName || '' %>" autocomplete="organization" required>
                <% if (errors.companyName) { %><p class="field-error"><%= errors.companyName %></p><% } %>
              </div>
              <div class="field">
                <label class="field-label" for="companyDescription">Firma tanıtımı <span class="optional">İsteğe bağlı</span></label>
                <textarea class="textarea" id="companyDescription" name="companyDescription" rows="3"><%= profile.companyDescription || '' %></textarea>
              </div>
              <div class="field">
                <label class="field-label" for="specialties">Hizmetler <span class="optional">Virgülle ayırın</span></label>
                <input class="input" type="text" id="specialties" name="specialties" value="<%= (profile.specialties || []).join(', ') %>" placeholder="Boya badana, Parke, Alçıpan">
              </div>
              <fieldset class="field check-grid-field">
                <legend class="field-label">Hizmet verdiğiniz kategoriler</legend>
                <div class="check-grid">
                  <% categories.forEach(category => { %>
                    <label class="check-line">
                      <input type="checkbox" name="categories" value="<%= category.name %>" <%= (profile.categories || []).includes(category.name) ? 'checked' : '' %>>
                      <%= category.name %>
                    </label>
                  <% }) %>
                </div>
                <p class="field-hint">Bu kategorilerde yeni talep açılınca bildirim alırsınız.</p>
              </fieldset>
              <% const serviceCities = profile.serviceCities || []; %>
              <fieldset class="field check-grid-field">
                <legend class="field-label">Hizmet verdiğiniz iller</legend>
                <details class="city-picker" <%= serviceCities.length ? 'open' : '' %>>
                  <summary><%= serviceCities.length ? serviceCities.join(', ') : 'Tüm Türkiye' %></summary>
                  <div class="check-grid city-grid">
                    <% allCities.forEach(city => { %>
                      <label class="check-line">
                        <input type="checkbox" name="serviceCities" value="<%= city %>" <%= serviceCities.includes(city) ? 'checked' : '' %>>
                        <%= city %>
                      </label>
                    <% }) %>
                  </div>
                </details>
                <p class="field-hint">Hiçbirini seçmezseniz tüm Türkiye'deki talepler için bildirim alırsınız.</p>
              </fieldset>
            <% } %>
            <div class="field <%= errors.address ? 'has-error' : '' %>">
              <label class="field-label" for="address"><%= profile.role === 'company' ? 'İl' : 'Adres' %> <span class="optional">İsteğe bağlı</span></label>
              <% if (profile.role === 'company') { %>
                <select class="select" id="address" name="address">
                  <option value="">Seçiniz</option>
                  <% allCities.forEach(city => { %><option value="<%= city %>" <%= profile.address === city ? 'selected' : '' %>><%= city %></option><% }) %>
                </select>
              <% } else { %>
                <input class="input" type="text" id="address" name="address" maxlength="200" value="<%= profile.address || '' %>" autocomplete="street-address">
              <% } %>
              <% if (errors.address) { %><p class="field-error"><%= errors.address %></p><% } %>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Kaydet</button></div>
          </form>
        </div>
      </section>

      <% if (profile.role === 'company') { %>
        <section class="box">
          <div class="box-head">Firma Logosu</div>
          <div class="box-body logo-row">
            <%- include('../partials/company-mark', { company: profile }) %>
            <form class="logo-form" action="/profile/logo" method="POST" enctype="multipart/form-data">
              <input class="input" type="file" name="logo" accept="image/jpeg,image/png,image/gif,image/webp" aria-label="Logo dosyası" required>
              <button class="btn" type="submit">Yükle</button>
            </form>
            <% if (profile.avatar) { %>
              <form action="/profile/logo/delete" method="POST"><button class="btn btn-danger-quiet" type="submit">Kaldır</button></form>
            <% } %>
          </div>
        </section>
      <% } %>

      <% if (profile.role === 'company') { %>
        <section class="box">
          <div class="box-head">İş Örnekleri (<%= (profile.portfolio || []).length %> / 8)</div>
          <div class="box-body">
            <% if ((profile.portfolio || []).length) { %>
              <div class="portfolio-grid portfolio-edit">
                <% profile.portfolio.forEach(image => { %>
                  <div>
                    <img src="<%= thumb(image) %>" alt="İş örneği" loading="lazy" width="240" height="180">
                    <form action="/profile/portfolio/delete" method="POST">
                      <input type="hidden" name="image" value="<%= image %>">
                      <button class="btn btn-sm btn-danger-quiet btn-block" type="submit">Kaldır</button>
                    </form>
                  </div>
                <% }) %>
              </div>
            <% } %>
            <form class="logo-form" action="/profile/portfolio" method="POST" enctype="multipart/form-data">
              <input class="input" type="file" name="images" multiple accept="image/jpeg,image/png,image/gif,image/webp" aria-label="İş örneği görselleri" required>
              <button class="btn" type="submit">Yükle</button>
            </form>
            <p class="field-hint" style="margin-top:6px">Yaptığınız işlerin fotoğrafları firma sayfanızda görünür. Fotoğraflardaki konum bilgisi otomatik silinir.</p>
          </div>
        </section>
      <% } %>

      <section class="box">
        <div class="box-head">E-posta Adresi</div>
        <div class="box-body" style="max-width:600px">
          <p class="muted" style="margin-bottom:8px">
            Mevcut adres: <strong><%= profile.email %></strong>
            <% if (profile.emailVerified === false) { %><span class="small">· Doğrulanmadı</span><% } %>
            <% if (profile.pendingEmail) { %><br><span class="small">Onay bekleyen yeni adres: <%= profile.pendingEmail %></span><% } %>
          </p>
          <form class="form" action="/profile/email" method="POST">
            <div class="field <%= errors.newEmail ? 'has-error' : '' %>">
              <label class="field-label" for="newEmail">Yeni e-posta adresi</label>
              <input class="input" type="email" id="newEmail" name="newEmail" maxlength="254" value="<%= locals.newEmail || '' %>" autocomplete="email" required>
              <% if (errors.newEmail) { %><p class="field-error"><%= errors.newEmail %></p><% } %>
            </div>
            <% if (profile.password) { %>
              <%- include('../partials/password-field', {
                fieldId: 'emailPassword', fieldLabel: 'Onay için şifreniz', autocomplete: 'current-password',
                fieldError: errors.emailPassword
              }) %>
            <% } %>
            <div class="form-actions"><button class="btn" type="submit">Doğrulama Bağlantısı Gönder</button></div>
          </form>
        </div>
      </section>

      <section class="box">
        <div class="box-head">E-posta Bildirimleri</div>
        <div class="box-body">
          <form class="form" action="/profile/notifications" method="POST">
            <% Object.entries(mailLabels).forEach(([key, label]) => { %>
              <label class="check-line">
                <input type="checkbox" name="<%= key %>" <%= !profile.emailPrefs || profile.emailPrefs[key] !== false ? 'checked' : '' %>>
                <%= label.charAt(0).toLocaleUpperCase('tr-TR') + label.slice(1) %>
              </label>
            <% }) %>
            <div class="form-actions"><button class="btn" type="submit">Tercihleri Kaydet</button></div>
          </form>
        </div>
      </section>

      <% if (socialProviders.length) { %>
        <section class="box">
          <div class="box-head">Bağlı Hesaplar</div>
          <div class="box-body">
            <ul class="linked-list">
              <% socialProviders.forEach(provider => {
                const linked = (profile.socialAccounts || []).some(account => account.provider === provider.key); %>
                <li>
                  <%- include('../partials/social-logo', { provider: provider.key }) %>
                  <span class="linked-name"><%= provider.label %><% if (linked) { %> <span class="small muted">· Bağlı</span><% } %></span>
                  <% if (linked) { %>
                    <form action="/profile/social/<%= provider.key %>/unlink" method="POST"><button class="btn btn-sm" type="submit">Kaldır</button></form>
                  <% } else { %>
                    <form action="/auth/<%= provider.key %>/link" method="POST"><button class="btn btn-sm" type="submit">Bağla</button></form>
                  <% } %>
                </li>
              <% }) %>
            </ul>
          </div>
        </section>
      <% } %>

      <section class="box">
        <div class="box-head"><%= profile.password ? 'Şifre Değiştir' : 'Şifre Belirle' %></div>
        <div class="box-body" style="max-width:600px">
          <% if (!profile.password) { %><p class="muted" style="margin-bottom:8px">Şifre belirlerseniz e-posta adresinizle de giriş yapabilirsiniz.</p><% } %>
          <form class="form" action="/profile/password" method="POST">
            <% if (profile.password) { %>
              <%- include('../partials/password-field', {
                fieldId: 'currentPassword', fieldLabel: 'Mevcut şifre', autocomplete: 'current-password',
                fieldError: errors.currentPassword
              }) %>
            <% } %>
            <%- include('../partials/password-field', {
              fieldId: 'newPassword', fieldLabel: 'Yeni şifre', autocomplete: 'new-password',
              minLength: 8, fieldError: errors.newPassword
            }) %>
            <div class="form-actions"><button class="btn" type="submit"><%= profile.password ? 'Şifreyi Değiştir' : 'Şifreyi Kaydet' %></button></div>
          </form>
        </div>
      </section>

      <section class="box">
        <div class="box-head">Oturumlar</div>
        <div class="box-body">
          <p class="muted" style="margin-bottom:8px">Telefonunuzu kaybettiyseniz veya ortak bir bilgisayarda açık bıraktıysanız diğer cihazlardaki oturumları kapatın.</p>
          <form action="/profile/sessions" method="POST"><button class="btn" type="submit">Diğer Cihazlardan Çıkış Yap</button></form>
        </div>
      </section>

      <section class="box">
        <div class="box-head">Verilerim</div>
        <div class="box-body">
          <p class="muted" style="margin-bottom:8px">Hesabınızdaki bilgileri, talepleri, teklifleri ve mesajları JSON dosyası olarak indirebilirsiniz.</p>
          <a class="btn" href="/profile/export">Verilerimi İndir</a>
        </div>
      </section>

      <section class="box">
        <div class="box-head" style="color:var(--red)">Hesabı Sil</div>
        <div class="box-body" style="max-width:600px">
          <p class="muted" style="margin-bottom:8px">Hesabınız, talepleriniz, teklifleriniz ve mesajlarınız kalıcı olarak silinir. Bu işlem geri alınamaz.</p>
          <form class="form" action="/profile/delete" method="POST"
            data-confirm="Hesabınız ve tüm verileriniz kalıcı olarak silinecek. Emin misiniz?" data-confirm-label="Hesabımı Sil" data-confirm-tone="danger">
            <% if (profile.password) { %>
              <%- include('../partials/password-field', {
                fieldId: 'password', fieldLabel: 'Onay için şifreniz', autocomplete: 'current-password',
                fieldError: errors.deletePassword
              }) %>
            <% } else { %>
              <div class="field <%= errors.deletePassword ? 'has-error' : '' %>">
                <label class="field-label" for="confirmEmail">Onay için e-posta adresiniz</label>
                <input class="input" type="email" id="confirmEmail" name="confirmEmail" autocomplete="off" required>
                <% if (errors.deletePassword) { %><p class="field-error"><%= errors.deletePassword %></p><% } %>
              </div>
            <% } %>
            <div class="form-actions"><button class="btn btn-danger-quiet" type="submit">Hesabımı Sil</button></div>
          </form>
        </div>
      </section>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
