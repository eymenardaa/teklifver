<%- include('../partials/header') %>

<div class="wrap page">
  <div class="layout">
    <aside><%- include('../partials/admin-menu') %></aside>

    <section class="box">
      <div class="result-bar">
        <span class="result-count"><strong><%= pager.total %></strong> kullanıcı</span>
        <form class="admin-search" action="/admin/users" method="GET">
          <input class="input" type="search" name="search" value="<%= search %>" placeholder="Ad, e-posta veya firma" aria-label="Kullanıcı ara">
          <button class="btn btn-sm" type="submit">Ara</button>
        </form>
      </div>
      <table class="listing-table bid-table">
        <thead>
          <tr><th>Kullanıcı</th><th class="col-date">Tür</th><th class="col-date">Üyelik</th><th class="col-status">Durum</th><th><span class="visually-hidden">İşlem</span></th></tr>
        </thead>
        <tbody>
          <% users.forEach(user => { %>
            <tr>
              <td>
                <strong><%= user.companyName || user.name %></strong>
                <% if (user.verified) { %><%- include('../partials/verified') %><% } %>
                <div class="listing-sub"><%= user.email %></div>
              </td>
              <td class="col-date"><%= user.isAdmin ? 'Yönetici' : user.role === 'company' ? 'Firma' : 'Bireysel' %></td>
              <td class="col-date"><%= memberSince(user.createdAt) %></td>
              <td class="col-status">
                <% if (user.suspended) { %><span class="badge badge-gray">Askıda</span><% } else { %><span class="badge badge-green">Aktif</span><% } %>
              </td>
              <td class="admin-actions">
                <div class="bid-actions">
                  <% if (user.role === 'company') { %>
                    <form class="plan-form" action="/admin/users/<%= user._id %>/plan" method="POST">
                      <label class="visually-hidden" for="plan-<%= user._id %>">Paket</label>
                      <select class="select select-sm" id="plan-<%= user._id %>" name="plan" data-autosubmit>
                        <% plans.forEach(plan => { %><option value="<%= plan.key %>" <%= (user.plan || 'free') === plan.key ? 'selected' : '' %>><%= plan.name %></option><% }) %>
                      </select>
                      <button class="btn btn-sm" type="submit">Kaydet</button>
                    </form>
                    <form action="/admin/users/<%= user._id %>/verify" method="POST">
                      <button class="btn btn-sm" type="submit"><%= user.verified ? 'Onayı Kaldır' : 'Onayla' %></button>
                    </form>
                  <% } %>
                  <% if (!user.isAdmin) { %>
                    <form action="/admin/users/<%= user._id %>/suspend" method="POST">
                      <button class="btn btn-sm btn-danger-quiet" type="submit"><%= user.suspended ? 'Aç' : 'Askıya Al' %></button>
                    </form>
                  <% } %>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
      <%- include('../partials/admin-pager') %>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
